# Copy to backend/.env and edit. Everything works offline with the defaults.

# LLM provider at start-up: mock (default, no key needed) or openai.
# You can also switch on the Settings page.
LLM_PROVIDER=mock

# --- OpenAI (used when AZURE_OPENAI_ENDPOINT is empty) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (used when AZURE_OPENAI_ENDPOINT is set) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Checks ---
SIMILARITY_THRESHOLD=0.40
MAX_FOLLOWUPS=2
# Pause between workflow steps so the "Checking..." labels are visible (seconds)
STEP_DELAY_SECONDS=0.5

# --- Paths (optional) ---
# DATABASE_URL=sqlite:///storage/qai.db
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
